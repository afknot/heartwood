# ---- Required ----
# The password you'll type on your phone. Make it long — this site is on the internet.
APP_PASSWORD=change-me-to-something-long

# ---- AI providers: easiest to add in Settings → AI & transcription. Or set them here. ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Career record exports (optional) ----
# Lets Heartwood open pull requests on your portfolio repo with drafts you approve (stories,
# resume updates). Create a fine-grained token on GitHub limited to that one repository, with
# Contents: Read and write, and Pull requests: Read and write. Easiest: paste it in Settings → Career export.
# GITHUB_TOKEN=

# ---- Local transcription (optional) ----
# Uncomment when you run:  docker compose --profile whisper up -d
# WHISPER_URL=http://whisper:9000
# Whisper model size: tiny, base, small, medium, large-v3 (bigger = more accurate, slower)
# WHISPER_MODEL=small

# ---- HTTPS (only if you use the bundled Caddy service) ----
HEARTWOOD_DOMAIN=

# ---- Encrypted backups (optional, recommended) ----
# Set a long passphrase to turn on nightly encrypted backups. KEEP IT SOMEWHERE SAFE:
# without it, the backups cannot be restored.
# RESTIC_PASSWORD=
# Where to store them. Default: ./backups on this server (encrypted, but same disk).
# For off-site, use e.g. a Backblaze B2 bucket:  RESTIC_REPOSITORY=b2:my-bucket:heartwood
# and add B2_ACCOUNT_ID / B2_ACCOUNT_KEY (or s3:..., sftp:... — see restic docs).
# Easiest: turn backups on in Settings → Your data & backups (Google Drive, connected from Settings).
# RESTIC_REPOSITORY=/backups
# Your timezone, so the nightly snapshot runs at 3am your time
# TZ=America/New_York

# ---- Meeting invites (optional) ----
# Easiest: set this up in Settings → Meetings & calendar. Or here.
# Give Heartwood its own mailbox (e.g. heartwood@yourdomain.com, created with your email host).
# Add that address to a meeting, or forward a meeting to it, and it shows up on Today, including
# new times and cancellations. Heartwood never replies. Everyone on the invite can see the address.
# INVITE_EMAIL=heartwood@yourdomain.com
# INVITE_PASSWORD=
# INVITE_IMAP_HOST=mail.yourdomain.com
# INVITE_IMAP_PORT=993
# Only invites from allowed senders are read. Add them in Settings → Meeting invites, and/or here
# (addresses, or @domain for everyone there).
# INVITE_ALLOWED_FROM=you@work.example

# ---- Notifications (optional) ----
# Contact sent to push services with notifications (defaults to your site address).
# PUSH_CONTACT=you@example.com

# ---- Rarely needed ----
# Set to false only when testing over plain http on your LAN (the mic won't work there anyway).
# HEARTWOOD_PORT=3410
# COOKIE_SECURE=true
# SESSION_DAYS=90
# MAX_UPLOAD_MB=500
